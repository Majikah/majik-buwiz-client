{
  "name": "@majikah/majik-buwiz-client",
  "type": "module",
  "description": "A TypeScript invoice management library that combines structured accounting logic with cryptographic envelope for signing, verification, encryption, and secure document workflows.",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "author": "Zelijah",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./accounting": {
      "types": "./dist/core/accounting/index.d.ts",
      "import": "./dist/core/accounting/index.js"
    },
    "./backup": {
      "types": "./dist/core/backup/index.d.ts",
      "import": "./dist/core/backup/index.js"
    },
    "./party": {
      "types": "./dist/core/party/index.d.ts",
      "import": "./dist/core/party/index.js"
    },
    "./storage": {
      "types": "./dist/core/storage/index.d.ts",
      "import": "./dist/core/storage/index.js"
    },
    "./expenses": {
      "types": "./dist/core/expenses/index.d.ts",
      "import": "./dist/core/expenses/index.js"
    },
    "./invoices": {
      "types": "./dist/core/invoice/invoice-manager.d.ts",
      "import": "./dist/core/invoice/invoice-manager.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majikah/majik-buwiz-client.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jedlsf"
  },
  "keywords": [
    "invoice",
    "accounting",
    "billing",
    "tax",
    "digital-signature",
    "content-signing",
    "post-quantum",
    "hybrid-cryptography",
    "ml-dsa-87",
    "ed25519",
    "csv-export",
    "majikah",
    "majik-buwiz"
  ],
  "homepage": "https://github.com/Majikah/majik-buwiz-client#readme",
  "bugs": {
    "url": "https://github.com/Majikah/majik-buwiz-client/issues"
  },
  "scripts": {
    "update": "npm install @majikah/majik-key-client@latest @majikah/majik-file@latest @majikah/majik-contact@latest @majikah/majik-key@latest @majikah/majik-signature@latest @majikah/majik-envelope@latest @thezelijah/majik-money@latest",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "package": "npm run build && npm version patch && git push && git push --tags",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@majikah/majik-cjson": "^0.0.3",
    "@majikah/majik-contact": "^0.2.0",
    "@majikah/majik-envelope": "^0.3.0",
    "@majikah/majik-file": "^0.6.0",
    "@majikah/majik-invoice": "^0.2.0",
    "@majikah/majik-key": "^1.0.2",
    "@majikah/majik-key-client": "^0.7.0",
    "@majikah/majik-signature": "^0.9.4",
    "@stablelib/sha256": "^2.0.1",
    "@thezelijah/majik-user": "^1.1.0",
    "fflate": "^0.8.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "vitest": "^5.0.2"
  }
}